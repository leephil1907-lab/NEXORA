# Supabase authentication, database and private storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — hosted chat, image generation and video generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional hosted chat fallbacks only
OMEGA_API_KEY=
# OMEGA_BASE_URL defaults to https://omegai.me/api/v1
VENICE_API_KEY=
# VENICE_BASE_URL defaults to https://api.venice.ai/api/v1

# Credit economy and upload limits
NEXORA_IMAGE_CREDIT_COST=1
NEXORA_VIDEO_CREDIT_COST=10
NEXORA_MAX_UPLOAD_MB=20

# 18+ sensitive-content mode (locked behind the in-app consent gate)
NEXORA_ALLOW_SENSITIVE=false

# App URL used for auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
