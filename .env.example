# Supabase (auth, Postgres, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Replicate — real GPU inference (Wan 2.x, LTX-Video, FLUX.1)
REPLICATE_API_TOKEN=

# Credit economy + limits
NEXORA_IMAGE_CREDIT_COST=1
NEXORA_VIDEO_CREDIT_COST=10
NEXORA_MAX_UPLOAD_MB=20

# Prompt assistant — OpenAI-compatible /v1/chat/completions
# e.g. llama.cpp server hosting AtomicChat/Inkling-2-Mini-Uncensored-GGUF or
# dongfangshuo/Dongfangshuo-Qwen3.8-27B-NSFW-v4
NEXORA_LLM_ENDPOINT=
NEXORA_LLM_API_KEY=
NEXORA_LLM_MODEL=default

# Custom image backend — OpenAI-compatible /v1/images/generations
# e.g. ComfyUI/LocalAI gateway hosting axiomofmind/Moss-image-nsfw-uncensored-lora-GGUF
NEXORA_IMAGE_ENDPOINT=
NEXORA_IMAGE_API_KEY=
NEXORA_IMAGE_MODEL=default

# 18+ sensitive-content mode (locked behind the in-app consent gate)
NEXORA_ALLOW_SENSITIVE=false

# App URL used for auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
